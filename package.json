{
  "name": "fewlinescss",
  "version": "0.0.0",
  "private": true,
  "description": "Platform-native UI system: semantic HTML, modern CSS, zero runtime JS.",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "apca-w3": "^0.1.9",
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lightningcss-cli"
    ]
  }
}
